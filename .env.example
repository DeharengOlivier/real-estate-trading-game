# Copy to .env and fill in. Never commit the real .env.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=realestate
REDIS_URL=redis://localhost:6379

# JWT signing key. There is no default and no placeholder that works: the API
# refuses to start without at least 32 characters of random material, because
# HS256 signs with the key itself and anyone holding it can forge a token for
# any account. Generate one with:
#     openssl rand -hex 32
SECRET_KEY=

API_HOST=0.0.0.0
API_PORT=8000
VITE_API_URL=http://localhost:8000
