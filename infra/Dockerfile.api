FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application. The seed scripts are not here: the API imports the market
# parameters from simulation/, and nothing else from seed/.
COPY api ./api
COPY simulation ./simulation

# Expose port
EXPOSE 8000

# Run FastAPI with uvicorn (without --reload for production-like behavior)
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
