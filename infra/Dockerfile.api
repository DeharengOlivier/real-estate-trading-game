FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application. The seed scripts are not here: the API imports the market
# parameters from simulation/, and nothing else from seed/.
COPY api ./api
COPY simulation ./simulation

# Expose port
EXPOSE 8000

# Run FastAPI with uvicorn (without --reload for production-like behavior).
#
# One worker is one core, whatever the machine has. UVICORN_WORKERS decides how
# many, defaulting to 1 so a laptop stack stays a laptop stack. `exec` keeps
# uvicorn as PID 1, so a `docker stop` reaches it rather than the shell.
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-1}"]
